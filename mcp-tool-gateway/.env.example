# The stdio + HTTP servers need no secrets. The host agent (/chat) needs a key.
ANTHROPIC_API_KEY=sk-ant-...

# Ports
# MCP_HTTP_PORT=8006          # Streamable HTTP gateway
# MCP_HOST_PORT=3002          # host agent

# Host wiring
# GATEWAY_HTTP_URL=http://localhost:8006/mcp
# HOST_MODEL=claude-opus-4-8

# Optional second, third-party MCP server (portability demo). Set to false to skip.
# ENABLE_THIRD_PARTY_MCP=true
# THIRD_PARTY_MCP_COMMAND=npx
# THIRD_PARTY_MCP_ARGS=-y,@modelcontextprotocol/server-everything
